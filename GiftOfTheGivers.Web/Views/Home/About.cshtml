@{
    ViewData["Title"] = "About";
}

<section class="py-5">
    <div class="container py-lg-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="section-label">About the Platform</span>

                <h1 class="display-4 fw-bold mb-4">
                    Supporting coordinated humanitarian relief.
                </h1>

                <p class="fs-5 text-secondary">
                    This prototype demonstrates how a central digital platform
                    could support Gift of the Givers by bringing donations,
                    volunteers and relief-project information together.
                </p>

                <p class="text-secondary">
                    The system is designed to make it easier for donors to
                    contribute, for volunteers to register their skills and
                    availability, and for employees to manage important
                    relief-related information.
                </p>

                <p class="text-secondary mb-0">
                    The Part 1 prototype focuses on demonstrating the design
                    and feasibility of these core features. More complete
                    application logic can be expanded in later development.
                </p>
            </div>

            <div class="col-lg-5">
                <div class="hero-info-card">
                    <span class="info-card-label">
                        Prototype Focus
                    </span>

                    <h2>One system. Several ways to help.</h2>

                    <p>
                        The platform connects the main areas required for
                        disaster-relief support through a simple and accessible
                        web application.
                    </p>

                    <div class="hero-stat">
                        <strong>Core areas</strong>
                        <span>
                            Donations • Volunteers • Relief Projects
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>