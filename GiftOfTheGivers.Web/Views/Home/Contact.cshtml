@{
    ViewData["Title"] = "Contact";
}

<section class="py-5">
    <div class="container py-lg-5">
        <div class="row g-5">
            <div class="col-lg-6">
                <span class="section-label">Contact</span>

                <h1 class="display-4 fw-bold mb-4">
                    Get in touch.
                </h1>

                <p class="fs-5 text-secondary mb-4">
                    This prototype provides a central point where users can
                    access information about donations, volunteering and
                    humanitarian relief activities.
                </p>

                <div class="service-card">
                    <h3>Need assistance?</h3>

                    <p>
                        For the prototype, this page demonstrates where
                        organisation contact information and support channels
                        would be made available to users.
                    </p>

                    <p class="mb-0">
                        <strong>General enquiries</strong><br />
                        Contact details would be managed by Gift of the Givers
                        in the production version of the platform.
                    </p>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-info-card h-100">
                    <span class="info-card-label">
                        Platform Support
                    </span>

                    <h2>
                        Helping users find the right information.
                    </h2>

                    <p>
                        The platform brings key humanitarian-support functions
                        into one place so that donors, volunteers and employees
                        can access the areas relevant to them.
                    </p>

                    <div class="hero-stat">
                        <strong>Available through the platform</strong>
                        <span>
                            Donations • Volunteer Registration • Relief Information
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>