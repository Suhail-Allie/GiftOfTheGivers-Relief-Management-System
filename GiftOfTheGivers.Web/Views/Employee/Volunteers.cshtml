@model IEnumerable<GiftOfTheGivers.Web.Models.Database.Volunteer>

@{
    ViewData["Title"] = "Volunteer Registrations";
}

<section class="py-5">
    <div class="container py-lg-5">
        <div class="d-flex flex-column flex-lg-row
                    justify-content-between align-items-lg-end
                    gap-3 mb-5">

            <div>
                <span class="section-label">Employee Area</span>

                <h1 class="display-5 fw-bold mb-3">
                    Volunteer Registrations
                </h1>

                <p class="fs-5 text-secondary mb-0">
                    Review submitted volunteer details, skills and availability.
                </p>
            </div>

            <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-outline-dark">
                Back to Dashboard
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="service-card text-center py-5">
                <h2 class="h4 fw-bold mb-3">
                    No volunteer registrations yet.
                </h2>

                <p class="text-secondary mb-0">
                    Submitted volunteer-interest forms will appear here
                    for Employee review.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle employee-table">
                    <thead>
                        <tr>
                            <th>Volunteer</th>
                            <th>Contact</th>
                            <th>Skills</th>
                            <th>Availability</th>
                            <th>Submitted</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var volunteer in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@volunteer.FullName</strong>

                                    <div class="small text-secondary">
                                        ID: @volunteer.VolunteerId
                                    </div>
                                </td>

                                <td>
                                    <div>
                                        @volunteer.Email
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        volunteer.PhoneNumber))
                                    {
                                        <div class="small text-secondary">
                                            @volunteer.PhoneNumber
                                        </div>
                                    }
                                </td>

                                <td>
                                    @volunteer.Skills
                                </td>

                                <td>
                                    @volunteer.Availability
                                </td>

                                <td>
    @(volunteer.RegistrationDate
        .ToLocalTime()
        .ToString("dd MMM yyyy HH:mm"))
</td>

                                <td>
                                    <span class="badge volunteer-status">
                                        @volunteer.VolunteerStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>