@model GiftOfTheGivers.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";

    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="py-5">
    <div class="container py-lg-5">
        <div class="row g-5 align-items-start">

            <div class="col-lg-5">
                <span class="section-label">
                    Secure Access
                </span>

                <h1 class="display-4 fw-bold mb-4">
                    Welcome back.
                </h1>

                <p class="fs-5 text-secondary">
                    Sign in securely to access the functionality available
                    to your donor or employee account.
                </p>

                <div class="hero-info-card mt-4">
                    <span class="info-card-label">
                        Role-Based Access
                    </span>

                    <h2>
                        One login. Different responsibilities.
                    </h2>

                    <p>
                        Donors can access registered donation features,
                        while employees can securely access relief-management
                        functionality.
                    </p>

                    <div class="hero-stat">
                        <strong>ASP.NET Identity</strong>

                        <span>
                            Secure authentication and role management
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="service-card bg-white p-4 p-lg-5">

                    <div class="mb-4">
                        <h2 class="fw-bold mb-2">
                            Sign In
                        </h2>

                        <p class="text-secondary mb-0">
                            Enter your registered account details.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          asp-route-returnUrl="@returnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="Enter your email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                            </label>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Login
                        </button>

                        <div class="text-center mt-4">
                            <p class="text-secondary mb-0">
                                Don't have a donor account?

                                <a asp-controller="Donor"
                                   asp-action="Register"
                                   class="fw-semibold">
                                    Register here
                                </a>
                            </p>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}